# prebuilt app packages — source lives in NBOSP/js/apps/<name>/, build with repackage.js
/NBOSP/js/apps/*.novaapp
# Supabase CLI local state
supabase/.temp/

# NBOSP/keys/ holds the AOSP-style PUBLIC test signing key plus its README.
# Everything else there (release keys, rotation candidates) stays ignored —
# only the deliberately-public test key pair is committed. See keys/README.md.
/NBOSP/keys/*
!/NBOSP/keys/test-system-key.json
!/NBOSP/keys/README.md
