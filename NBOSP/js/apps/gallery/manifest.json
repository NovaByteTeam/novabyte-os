{
  "id": "com.nbosp.gallery",
  "name": "Gallery",
  "version": "3.0.2",
  "description": "Image Viewer",
  "author": "NovaByte",
  "entry": "index.html",
  "icon": "image",
  "type": "blank",
  "permissions": [
    "vfs:read"
  ],
  "defaultSize": [840, 580],
  "minSize": [500, 360],
  "resizable": true,
  "frame": true,
  "categories": ["media", "utilities"],
  "handles": {
    "protocols": [],
    "extensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg", ".avif", ".tiff"]
  },
  "system": true
}
