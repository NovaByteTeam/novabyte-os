{
  "name": "novabyte-server",
  "version": "3.0.2",
  "description": "NovaByte Server",
  "main": "client.js",
  "scripts": {
    "start": "nw .",
    "prestart": "node scripts/bootstrap.js && node scripts/build-apps-on-start.js",
    "predev": "node scripts/bootstrap.js && node scripts/build-apps-on-start.js",
    "dev": "nw . --enable-logging=stderr --v=1",
    "test": "npx vitest run --reporter=verbose",
    "clean": "node -e \"const {exec}=require('child_process');exec(process.platform==='win32'?'taskkill /F /IM nw.exe':'pkill -x nw; pkill -x nwjs; exit 0',()=>console.log('\\u2714 Cleared.'))\""
  },
  "window": {
    "title": "NovaByte",
    "width": 1280,
    "height": 720,
    "min_width": 800,
    "min_height": 500,
    "frame": true,
    "icon": "assets/icon.png",
    "icons": {
      "128": "assets/icon.png"
    },
    "dev_tools": true,
    "user-data-dir": "./nwjs-data",
    "remote-debugging-port": 9222,
    "auto-open-devtools-for-tabs": true
  },
  "chromium-args": "--no-first-run --disable-features=Vulkan,CalculateNativeWinOcclusion --enable-zero-copy --ignore-gpu-blocklist --disable-background-timer-throttling --disable-renderer-backgrounding --disable-raf-throttling --disable-ipc-flooding-protection --disable-web-security --allow-file-access-from-files",
  "js-flags": "--expose-gc --max-old-space-size=4096 --opt --turbo",
  "node-remote": "https://localhost:*",
  "keywords": [
    "Server"
  ],
  "author": "DirazCoder",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@peculiar/x509": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "i18next": "^26.5.6",
    "imapflow": "^2.9.1",
    "multer": "^2.5.0",
    "node-pop3": "^0.15.3",
    "nodemailer": "^10.2.1",
    "postal-mime": "^4.1.4",
    "reflect-metadata": "^0.2.2",
    "tar": "^7.5.22",
    "undici": "^8.12.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "nw": "^0.119.2-sdk",
    "nw-builder": "^4.24.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "nw-builder@4.18.0": true,
    "better-sqlite3@13.0.3": true,
    "nw@0.119.2-sdk": true
  }
}
