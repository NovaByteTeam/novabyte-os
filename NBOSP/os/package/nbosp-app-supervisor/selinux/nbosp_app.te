policy_module(nbosp_app, 1.0)

gen_require(`
	type init_t, initrc_t, lib_t, unconfined_t, user_t, var_lib_t, var_run_t, var_t;
	role system_r;
')

type nbosp_app_t;
domain_type(nbosp_app_t)
role system_r types nbosp_app_t;

type nbosp_app_runtime_exec_t;
domain_entry_file(nbosp_app_t, nbosp_app_runtime_exec_t)

type nbosp_app_supervisor_service_t;
type nbosp_app_supervisor_service_exec_t;
init_daemon_domain(nbosp_app_supervisor_service_t,
		   nbosp_app_supervisor_service_exec_t)

type nbosp_app_supervisor_t;
type nbosp_app_supervisor_exec_t;
domain_auto_trans(nbosp_app_supervisor_service_t,
		  nbosp_app_supervisor_exec_t,
		  nbosp_app_supervisor_t)
unconfined_domain(nbosp_app_supervisor_t)
domain_auto_trans(nbosp_app_supervisor_t, nbosp_app_runtime_exec_t,
		  nbosp_app_t)

type nbosp_app_package_t;
files_type(nbosp_app_package_t)

type nbosp_app_data_t;
files_type(nbosp_app_data_t)

type nbosp_wayland_socket_t;
files_type(nbosp_wayland_socket_t)

allow nbosp_app_t nbosp_app_package_t:dir {
	getattr ioctl lock open read search
};
allow nbosp_app_t nbosp_app_package_t:file {
	getattr ioctl lock map open read
};
allow nbosp_app_t nbosp_app_data_t:dir {
	add_name create getattr ioctl lock open read remove_name search setattr write
};
allow nbosp_app_t nbosp_app_data_t:file {
	append create getattr ioctl lock map open read rename setattr unlink write
};

allow nbosp_app_t self:process { execmem getsched getpgid setpgid };
allow nbosp_app_t self:fd use;
allow nbosp_app_t self:fifo_file rw_fifo_file_perms;
allow nbosp_app_t self:unix_dgram_socket create_socket_perms;
allow nbosp_app_t self:unix_stream_socket create_stream_socket_perms;
allow nbosp_app_t self:tcp_socket create_stream_socket_perms;
allow nbosp_app_t nbosp_wayland_socket_t:sock_file write;
allow nbosp_app_t initrc_t:unix_stream_socket connectto;
allow nbosp_app_t unconfined_t:unix_stream_socket connectto;
allow nbosp_app_t user_t:unix_stream_socket connectto;
allow nbosp_app_t nbosp_wayland_socket_t:dir {
	getattr open read search
};
allow nbosp_app_t var_t:dir search;
allow nbosp_app_t var_lib_t:dir search;
allow nbosp_app_t var_run_t:dir search;
allow nbosp_app_t lib_t:file { getattr map open read };

files_read_etc_files(nbosp_app_t)
files_read_usr_files(nbosp_app_t)
libs_use_ld_so(nbosp_app_t)
libs_read_lib_files(nbosp_app_t)
miscfiles_read_localization(nbosp_app_t)
dev_read_urand(nbosp_app_t)
dev_read_null(nbosp_app_t)
corenet_tcp_connect_generic_port(nbosp_app_t)

type_transition nbosp_app_supervisor_t var_lib_t:dir nbosp_app_data_t
	"nbosp-app-data";
type_transition nbosp_app_supervisor_t var_lib_t:dir nbosp_app_package_t
	"nbosp-app-packages";
