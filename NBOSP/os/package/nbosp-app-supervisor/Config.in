config BR2_PACKAGE_NBOSP_APP_SUPERVISOR
	bool "NBOSP per-app UID supervisor"
	depends on BR2_x86_64
	select BR2_PACKAGE_LIBSELINUX
	select BR2_PACKAGE_POLICYCOREUTILS
	select BR2_PACKAGE_REFPOLICY
	help
	  Install a root-only helper and a peer-credential-checked Unix socket
	  service for installing, launching, terminating, and removing verified
	  apps under stable per-app UIDs. App processes receive seccomp and rlimit
	  restrictions and are placed in resource-limited cgroup v2 groups. The
	  package also supplies the early SELinux policy-loading init wrapper.
