#!/bin/sh

DAEMON=/usr/sbin/nbosp-app-supervisor-service
PIDFILE=/run/nbosp-app-supervisor.pid

case "${1:-}" in
	start)
		if [ ! -r /sys/fs/selinux/policyvers ]; then
			echo "SELinux policy is not loaded; refusing to start the app supervisor." >&2
			exit 1
		fi
		if [ ! -x "$DAEMON" ]; then
			echo "NBOSP app supervisor service is missing: $DAEMON" >&2
			exit 1
		fi
		start-stop-daemon --start --background --make-pidfile \
			--pidfile "$PIDFILE" --exec "$DAEMON"
		;;
	stop)
		if [ -f "$PIDFILE" ]; then
			start-stop-daemon --stop --pidfile "$PIDFILE"
			rm -f "$PIDFILE"
		fi
		rm -f /run/nbosp-app-supervisor.sock
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
