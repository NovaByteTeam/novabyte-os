# NovaByte OS Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# HTTPS Certificate (mkcert local CA)
NODE_EXTRA_CA_CERTS=ca.crt

# Security (optional - auto-generated if not set)
SESSION_SECRET=your-session-secret-change-this-in-production
TOKEN_ENCRYPTION_KEY=your-encryption-key-change-this-in-production
ACCOUNT_ENCRYPTION_KEY=your-account-encryption-key-change-this

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================
# OAUTH CONFIGURATION (Optional)
# =============================================
# For OAuth-based connections (Gmail, Outlook)
# You need to create a project in Google Cloud Console
# and Microsoft Azure Portal to get these credentials

# Google OAuth (for Gmail)
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and enable Gmail API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add http://localhost:3002 as redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback

# Microsoft OAuth (for Outlook, Office 365)
# 1. Go to https://portal.azure.com/
# 2. Register an application
# 3. Add API permissions for Mail.Read, Mail.Send
# 4. Create client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3002/api/auth/microsoft/callback

# =============================================
# AI SERVICE (Optional)
# =============================================
AI_PROVIDER=anthropic

CS_PUBLIC_REPO=NovaByteOfficial/novabyte-cs

# Configure the update admin token for publishing signed update packages
UPDATE_ADMIN_TOKEN=

# Default update channel for auto-update polls (stable or beta)
UPDATE_CHANNEL=stable
